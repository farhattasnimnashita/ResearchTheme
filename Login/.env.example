# Local development. Go reads .env automatically; existing environment variables win.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_URL=http://localhost:8080
DB_PATH=researchbridge.db
# Real Gmail delivery. Keep your existing .env when applying an update.
EMAIL_MODE=smtp
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM may be blank in SMTP mode; the app uses SMTP_USER as the sender.
EMAIL_FROM=
# Alternative: EMAIL_MODE=resend with a verified sender and an API key.
RESEND_API_KEY=
# Explicit offline development only: EMAIL_MODE=console prints links, never sends email.
