# Local development. Go reads .env automatically; existing environment variables win.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_URL=http://localhost:8080
DB_PATH=researchbridge.db
# console prints the verification link in your terminal; it DOES NOT send email.
EMAIL_MODE=console
# For real delivery: EMAIL_MODE=resend and fill these values locally.
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP alternative (personal Gmail; no custom domain). Existing .env is preserved.
# EMAIL_MODE=smtp
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your_16_character_google_app_password
# EMAIL_FROM=ResearchBridge <youraddress@gmail.com>
